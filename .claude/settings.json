{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(gh pr merge * --admin *)",
      "Bash(gh pr merge * --admin)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh api -X DELETE *)"
    ]
  }
}
