  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/fork_gh_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__ccd_session__start_session",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
