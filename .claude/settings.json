{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f *)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f)",
      "Bash(git -C * push * -f *)",
      "Bash(git -C * push * +*)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git -C * push * main)",
      "Bash(git -C * push * main *)",
      "Bash(git -C * push *:main)",
      "Bash(git -C * push *:main *)",
      "Bash(git -C * push *:refs/heads/main*)",
      "Bash(git push * parametric)",
      "Bash(git push * parametric *)",
      "Bash(git push *:parametric)",
      "Bash(git push *:parametric *)",
      "Bash(git push *:refs/heads/parametric*)",
      "Bash(git -C * push * parametric)",
      "Bash(git -C * push * parametric *)",
      "Bash(git -C * push *:parametric)",
      "Bash(git -C * push *:parametric *)",
      "Bash(git -C * push *:refs/heads/parametric*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push --follow-tags*)",
      "Bash(git push * --follow-tags*)",
      "Bash(git push *refs/tags/*)",
      "Bash(git push * tag *)",
      "Bash(git push origin v*)",
      "Bash(git -C * push --tags*)",
      "Bash(git -C * push * --tags*)",
      "Bash(git -C * push --follow-tags*)",
      "Bash(git -C * push * --follow-tags*)",
      "Bash(git -C * push *refs/tags/*)",
      "Bash(git -C * push * tag *)",
      "Bash(git -C * push origin v*)",
      "Bash(git tag *)",
      "Bash(git -C * tag *)",
      "Bash(gh release create*)",
      "Bash(gh release edit*)",
      "Bash(gh release upload*)",
      "Bash(gh release delete*)",
      "Bash(gh release new*)",
      "Bash(gh -* release create*)",
      "Bash(gh -* release new*)",
      "Bash(gh -* release edit*)",
      "Bash(gh -* release upload*)",
      "Bash(gh -* release delete*)",
      "Bash(gh release -* create*)",
      "Bash(gh release -* new*)",
      "Bash(gh release -* edit*)",
      "Bash(gh release -* upload*)",
      "Bash(gh release -* delete*)",
      "Bash(gh workflow run*)",
      "Bash(gh workflow enable*)",
      "Bash(gh workflow disable*)",
      "Bash(gh -* workflow run*)",
      "Bash(gh -* workflow enable*)",
      "Bash(gh -* workflow disable*)",
      "Bash(gh workflow -* run*)",
      "Bash(gh workflow -* enable*)",
      "Bash(gh workflow -* disable*)",
      "Bash(gh api *dispatches*)",
      "Bash(gh api *git/refs*)",
      "Bash(gh api *git/tags*)",
      "Bash(gh api *releases*)",
      "Bash(git push upstream*)",
      "Bash(git -C * push upstream*)",
      "Bash(gh pr create --repo RiskThinking*)",
      "Bash(gh issue create --repo RiskThinking*)",
      "Bash(gh api *repos/RiskThinking*)",
      "Bash(gh * --repo RiskThinking*)",
      "Bash(gh * --repo=RiskThinking*)",
      "Bash(gh * -R RiskThinking*)",
      "Bash(gh * github.com/RiskThinking*)",
      "Bash(gh api *RiskThinking*)",
      "Bash(gh * --repo riskthinking*)",
      "Bash(gh * --repo=riskthinking*)",
      "Bash(gh * -R riskthinking*)",
      "Bash(gh * github.com/riskthinking*)",
      "Bash(gh api *riskthinking*)",
      "Bash(gh *RiskThinking/*)",
      "Bash(gh *riskthinking/*)",
      "Bash(GH_REPO=*)",
      "Bash(env GH_REPO=*)",
      "Bash(export GH_REPO*)",
      "Bash(gh pr merge * --admin *)",
      "Bash(gh pr merge * --admin)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh -* pr merge *--admin*)",
      "Bash(gh pr -* merge *--admin*)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo create*)",
      "Bash(gh repo new*)",
      "Bash(gh repo fork*)",
      "Bash(gh repo sync*)",
      "Bash(gh api -X DELETE *)",
      "mcp__terminal__run_in_terminal"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/fork_gh_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
